# 叙境 Narraverse — Environment Variables
# ========================================

# ── Database (PostgreSQL) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=narraverse
DB_USER=narraverse
DB_PASSWORD=narraverse
DATABASE_URL=postgresql://narraverse:narraverse@localhost:5432/narraverse

# ── Auth ───────────────────────────────────────────────────
# Session secret (change in production! generate with: openssl rand -hex 32)
SESSION_SECRET=dev-session-secret-change-in-production-64chars

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# ── Email SMTP (for OTP verification) ──────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="叙境 Narraverse" <noreply@example.com>

# ── API Key Encryption (change in production!) ─────────────
API_KEY_ENCRYPTION_KEY=dev-encryption-key-change-in-prod-32chars

# ── LLM Providers ──────────────────────────────────────────

# DeepSeek (primary)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Grok / xAI (premium)
GROK_API_KEY=sk-your-grok-key
GROK_BASE_URL=https://api.x.ai
GROK_MODEL=grok-4-fast

# OpenAI (fallback)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o

# ── Deployment ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Invite System (optional) ────────────────────────────────
# Set to "true" to require invite code for new users
REQUIRE_INVITE=true
# Comma-separated whitelist of emails that bypass invite requirement
INVITE_WHITELIST=admin@example.com